<?xml version="1.0"?>
<ruleset name="identvia-login">
	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/tests/*</exclude-pattern>
	<exclude-pattern>/wp/*</exclude-pattern>
	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<config name="minimum_wp_version" value="6.2"/>
	<config name="testVersion" value="7.4-"/>
	<rule ref="WordPress"/>
	<rule ref="WordPress.Files.FileName.NotHyphenatedLowercase"><exclude-pattern>/blocks/*/*.asset.php</exclude-pattern></rule>
	<rule ref="PHPCompatibilityWP"/>
	<rule ref="WordPress.WP.I18n"><properties><property name="text_domain" type="array"><element value="identvia-login"/></property></properties></rule>
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals"><properties><property name="prefixes" type="array"><element value="identvia"/></property></properties></rule>
</ruleset>
